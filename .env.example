# Copy to .env.local for local development, and add the same names in
# Vercel > Project > Settings > Environment Variables for the live site.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Needed for admin, applications and job alerts.
SUPABASE_SECRET_KEY=

# --- Sign-in (Auth.js) ---
# Any long random string. Generate one with:  npx auth secret
AUTH_SECRET=
# Roblox: create.roblox.com > Credentials > OAuth 2.0 apps
# Redirect URL: https://YOUR-SITE/api/auth/callback/roblox   Scopes: openid, profile
AUTH_ROBLOX_ID=
AUTH_ROBLOX_SECRET=
# Discord: discord.com/developers/applications > OAuth2
# Redirect URL: https://YOUR-SITE/api/auth/callback/discord
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Who can use /admin, as provider:accountId, comma separated.
# Sign in once and open /admin to see your own ID.
ADMIN_IDS=

# --- Email (resend.com) ---
RESEND_API_KEY=
EMAIL_FROM="GBR Careers <noreply@yourdomain.com>"
# Used for links in emails
SITE_URL=https://gbrrblxweb.vercel.app
